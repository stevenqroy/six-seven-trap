{
  "name": "six-seven-trap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/play-local.sh",
    "play": "./scripts/play-local.sh",
    "dev:local": "./scripts/with-node.sh npm run dev",
    "verify": "npm run lint && npm run build",
    "verify:local": "./scripts/with-node.sh npm run verify",
    "build": "vite build",
    "build:local": "./scripts/with-node.sh npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:local": "./scripts/with-node.sh npm run lint",
    "sprite:clean": "./scripts/with-node.sh node scripts/clean-sprite-sheet.mjs",
    "sprite:cleanthis": "./scripts/with-node.sh node scripts/build-cleanthis-best-sheet.mjs",
    "sprite:testmp4": "./scripts/build-testmp4-sheet.sh",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:fail-check": "S7R_FORCE_FAIL=1 vitest run tests/harness/fail-check.test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:all:local": "./scripts/with-node.sh npm run test:all",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark:mobile": "node ./scripts/mobile-benchmark.mjs",
    "benchmark:mobile:local": "./scripts/with-node.sh npm run benchmark:mobile",
    "validate:all": "npm run lint && npm run test:all && npm run build",
    "validate:all:local": "./scripts/with-node.sh npm run validate:all"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "imagetracerjs": "^1.2.6",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "potrace": "^2.1.8",
    "prettier": "^3.5.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
